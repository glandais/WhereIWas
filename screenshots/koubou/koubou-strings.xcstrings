{
  "sourceLanguage": "en-US",
  "strings": {
    "All-day battery: stand still and it switches off.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šetří baterii: v klidu se vypne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Schont den Akku: Im Stand schaltet es ab."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "All-day battery: stand still and it switches off."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorra batería: si está quieto, se apaga."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie préservée : à l'arrêt, il s'éteint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmia batteria: da fermo si spegne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静止すればオフ、​バッテリーは​一日もつ。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuinig: bij stilstand gaat de GPS uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszczędza baterię: w bezruchu się wyłącza."
          }
        }
      }
    },
    "Every point, explained": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý bod s vysvětlením"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Punkt, erklärt"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Every point, explained"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada punto, explicado"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque point, expliqué"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni punto, spiegato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての​測位に、​理由を"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk punt, uitgelegd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy punkt z wyjaśnieniem"
          }
        }
      }
    },
    "Every trip, day by day, street by street.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý výlet, den po dni, ulici po ulici."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Reise, Tag für Tag, Straße für Straße."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Every trip, day by day, street by street."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada viaje, día a día, calle por calle."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque voyage, jour après jour, rue par rue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni spostamento, giorno per giorno, strada per strada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての旅を、​一日ずつ​地図で。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke rit, dag na dag, straat voor straat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda wycieczka, dzień po dniu, ulica po ulicy."
          }
        }
      }
    },
    "Export your trips as GPX": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Export cest do GPX"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Reisen als GPX exportieren"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your trips as GPX"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte sus viajes en GPX"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez vos trajets en GPX"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta i tuoi viaggi in GPX"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅の記録を​GPXで​書き出し"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer uw ritten als GPX"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj trasy do GPX"
          }
        }
      }
    },
    "GPS runs only while you move": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS běží jen za pohybu"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS läuft nur, wenn Sie sich bewegen"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS runs only while you move"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El GPS solo funciona si usted se mueve"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS ne tourne que si vous bougez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il GPS si accende solo in movimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPSが動くのは​移動中だけ"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS draait alleen tijdens beweging"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS działa tylko podczas ruchu"
          }
        }
      }
    },
    "Keeps recording through reboots and no signal.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenává dál i po restartu a bez signálu."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet weiter auf – trotz Neustart und ohne Netz."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps recording through reboots and no signal."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue registrando tras reinicios y sin cobertura."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue malgré les redémarrages et sans réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a registrare dopo i riavvii e senza segnale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動しても、​圏外でも​途切れない。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft registreren na een herstart en zonder bereik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet po restarcie i bez zasięgu."
          }
        }
      }
    },
    "Logs every trip, screen off": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá cesta, i se zhasnutým displejem"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Reise, auch bei Display aus"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs every trip, screen off"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada viaje, con la pantalla apagada"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque trajet, écran éteint"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni viaggio, a schermo spento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面オフでも、​旅を​まるごと記録"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke rit, ook met het scherm uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje każdą trasę w tle"
          }
        }
      }
    },
    "Or JSON. Nothing leaves your iPhone unless you share it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebo do JSON. Nic neopustí iPhone bez vašeho souhlasu."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder als JSON. Nichts verlässt Ihr iPhone ohne Sie."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Or JSON. Nothing leaves your iPhone unless you share it."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "O en JSON. Nada sale de su iPhone sin usted."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou en JSON. Rien ne quitte votre iPhone sans vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "O in JSON. Nulla lascia l'iPhone senza di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONにも対応。​共有しない限り、​データは​iPhoneの中だけ。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Of als JSON. Niets verlaat uw iPhone zonder u."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albo do JSON. Nic nie opuszcza iPhone’a bez Twojej zgody."
          }
        }
      }
    },
    "Why each GPS position was kept or dropped.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč byla každá poloha GPS ponechána, nebo zahozena."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum jede GPS-Position behalten oder verworfen wurde."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Why each GPS position was kept or dropped."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué cada posición GPS se guardó o se descartó."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi chaque position GPS a été gardée ou écartée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché ogni posizione GPS è stata tenuta o scartata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各位置が​採用・除外された​理由まで​記録。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom elke GPS-positie is bewaard of verworpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego każda pozycja GPS została zachowana lub odrzucona."
          }
        }
      }
    },
