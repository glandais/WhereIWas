        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een volledige dag, straat voor straat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cały dzień, ulica po ulicy."
          }
        }
      }
    },
    "Every day, on the map": {
