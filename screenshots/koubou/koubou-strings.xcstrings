{
  "sourceLanguage": "en-US",
  "strings": {
    "A full day, street by street.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý den, ulici po ulici."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ganzer Tag, Straße für Straße."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A full day, street by street."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día completo, calle por calle."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée entière, rue par rue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'intera giornata, strada per strada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まる一日を、​街路に沿って。"
          }
