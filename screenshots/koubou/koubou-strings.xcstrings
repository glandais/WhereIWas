    "Every fix, accepted or rejected": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý fix, přijatý i odmítnutý"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Fix, akzeptiert oder abgelehnt"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Every fix, accepted or rejected"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada posición, aceptada o rechazada"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque point, accepté ou rejeté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni fix, accettato o rifiutato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての測位を、​採否まで記録"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke fix, geaccepteerd of geweigerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy fix, zaakceptowany lub odrzucony"
          }
        }
      }
    },
    "GPS runs only while you move": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS běží jen za pohybu"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS läuft nur, wenn Sie sich bewegen"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS runs only while you move"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El GPS solo funciona si usted se mueve"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS ne tourne que si vous bougez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il GPS si accende solo in movimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPSが動くのは​移動中だけ"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS draait alleen tijdens beweging"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS działa tylko podczas ruchu"
          }
        }
      }
    },
    "GPX or JSON, with speed, accuracy, activity and battery.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX nebo JSON, s rychlostí, přesností, aktivitou i baterií."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX oder JSON, mit Geschwindigkeit, Genauigkeit, Aktivität und Akkustand."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX or JSON, with speed, accuracy, activity and battery."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX o JSON, con velocidad, precisión, actividad y batería."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX ou JSON, avec vitesse, précision, activité et batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX o JSON, con velocità, precisione, attività e batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPXまたはJSONで、​速度・精度・​活動・バッテリーまで。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX of JSON, met snelheid, nauwkeurigheid, activiteit en batterij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPX lub JSON, z prędkością, dokładnością, aktywnością i baterią."
          }
        }
      }
    },
    "Records with the screen off": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenává i se zhasnutým displejem"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet bei ausgeschaltetem Display auf"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Records with the screen off"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra con la pantalla apagada"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre écran éteint"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra a schermo spento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面オフでも​記録を継続"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreert met het scherm uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje z wygaszonym ekranem"
          }
        }
      }
    },
    "Stand still and it switches off. Move and it is back in seconds.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavte se a GPS se vypne. Pohněte se a je zpět za pár sekund."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Stand schaltet es ab, bei Bewegung ist es in Sekunden zurück."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand still and it switches off. Move and it is back in seconds."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédese quieto y se apaga. Muévase y vuelve en segundos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'arrêt, il s'éteint. Au premier pas, il revient en quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermo, si spegne. Ti muovi, si riaccende in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静止すればオフ、​動けば数秒で復帰。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilstaan schakelt de GPS uit. Bewegen zet hem binnen seconden weer aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stań w miejscu, a się wyłączy. Ruszaj się, a wróci w kilka sekund."
          }
        }
      }
    },
    "Survives termination, reboot and no signal.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přežije ukončení, restart i výpadek signálu."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersteht Beendigung, Neustart und fehlendes Netz."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Survives termination, reboot and no signal."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Resiste cierres, reinicios y la falta de cobertura."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Résiste aux arrêts iOS, redémarrages et coupures réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resiste a chiusure, riavvii e assenza di segnale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強制終了・再起動・​圏外でも途切れない。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Overleeft beëindiging, herstart en geen bereik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetrwa zamknięcie, restart i brak zasięgu."
          }
        }
      }
    },
    "With the reason, the threshold and the measured value.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S důvodem, prahem a naměřenou hodnotou."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Grund, Schwellenwert und gemessenem Wert."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "With the reason, the threshold and the measured value."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el motivo, el umbral y el valor medido."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec la raison, le seuil et la valeur mesurée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il motivo, la soglia e il valore misurato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由・しきい値・​測定値つきで。"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de reden, de drempel en de gemeten waarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z powodem, progiem i zmierzoną wartością."
          }
        }
      }
    },
    "Your data leaves when you say so": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data odejdou, až budete chtít"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie entscheiden, wann Ihre Daten das iPhone verlassen"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data leaves when you say so"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos salen cuando usted decide"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données ne partent que sur ordre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati escono quando decidi tu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外に出すのは、​自分で​決めたときだけ"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw gegevens gaan pas weg als u het zegt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty decydujesz, kiedy dane opuszczają telefon"
          }
        }
      }
    }
  },
  "version": "1.0"
}
