    "settings.permissions.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledování na pozadí vyžaduje přístup k poloze nastavený na „Vždy“ se zapnutou funkcí Přesná poloha. „Pohyb a kondice“ umožňuje aplikaci vypnout GPS, když jste v klidu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung im Hintergrund erfordert, dass der Standortzugriff auf „Immer“ gesetzt und Genauer Standort aktiviert ist. „Bewegung & Fitness“ ermöglicht es der App, das GPS auszuschalten, während Sie sich nicht bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background tracking requires location access set to “Always” with Precise Location on. Motion & Fitness lets the app switch GPS off while you are still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento en segundo plano exige que el acceso a la ubicación esté configurado en «Siempre», con Ubicación precisa activada. Movimiento y forma física permite que la app apague el GPS en caso de inmovilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi en arrière-plan exige un accès à la position réglé sur « Toujours », avec la position précise activée. « Mouvement et forme » permet à l’app d’éteindre le GPS lorsque vous êtes immobile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il monitoraggio in background richiede l'accesso alla posizione impostato su «Sempre», con Posizione esatta attivata. Movimento e fitness consente all'app di spegnere il GPS in assenza di movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドでの追跡には、位置情報へのアクセスを「常に」に設定し、正確な位置情報をオンにする必要があります。「モーションとフィットネス」により、静止中はGPSをオフに切り替えられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijhouden op de achtergrond vereist dat locatietoegang is ingesteld op „Altijd”, met Precieze locatie ingeschakeld. Beweging en fitness laat de app de GPS uitschakelen bij stilstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledzenie w tle wymaga dostępu do lokalizacji ustawionego na „Zawsze”, z włączoną opcją Dokładna lokalizacja. „Ruch i sprawność” pozwala aplikacji wyłączać GPS w czasie bezruchu."
          }
        }
      }
    },
