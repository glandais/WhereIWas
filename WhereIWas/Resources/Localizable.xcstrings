    "settings.profiles.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtr vzdálenosti podle aktivity. Rychlost nad %1$@ vždy vybere profil pro řízení; neznámá aktivita nad %2$@ použije filtr pro běh."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanzfilter je Aktivität. Eine Geschwindigkeit über %1$@ wählt immer das Fahrprofil; eine unbekannte Aktivität über %2$@ verwendet den Filter für Laufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance filter per activity. Speed above %1$@ always selects the driving profile; unknown activity above %2$@ uses the running filter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtro de distancia por actividad. Una velocidad superior a %1$@ selecciona siempre el perfil de conducción; una actividad desconocida por encima de %2$@ usa el filtro de carrera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre de distance par activité. Une vitesse supérieure à %1$@ sélectionne toujours le profil automobile ; une activité inconnue au-dessus de %2$@ utilise le filtre course à pied."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtro di distanza per attività. Una velocità superiore a %1$@ seleziona sempre il profilo auto; un'attività sconosciuta sopra %2$@ utilizza il filtro corsa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティごとの距離フィルタです。速度が%1$@を超えると常に自動車のプロファイルが選択され、不明なアクティビティで%2$@を超えるとランニングのフィルタが使用されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstandsfilter per activiteit. Een snelheid boven %1$@ selecteert altijd het autoprofiel; een onbekende activiteit boven %2$@ gebruikt het hardloopfilter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtr odległości zależny od aktywności. Prędkość powyżej %1$@ zawsze wybiera profil samochodowy; nieznana aktywność powyżej %2$@ używa filtru dla biegu."
          }
        }
      }
    },
