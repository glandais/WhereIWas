    "Distance filter per activity. Speed above %@ always selects the driving profile; unknown activity above %@ uses the running filter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Distance filter per activity. Speed above %1$@ always selects the driving profile; unknown activity above %2$@ uses the running filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre de distance par activité. Une vitesse supérieure à %@ sélectionne toujours le profil automobile ; une activité inconnue au-dessus de %@ utilise le filtre course à pied."
          }
        }
      }
    },
