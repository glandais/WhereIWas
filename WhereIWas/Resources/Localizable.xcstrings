    },
    "phase.probing.explanation" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS se krátce zapne, aby se ověřilo, zda dochází k pohybu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das GPS ist kurz aktiv, um zu prüfen, ob Sie sich bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS is on briefly to confirm whether you are moving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El GPS se activa brevemente para confirmar si hay movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le GPS est activé brièvement pour confirmer si vous vous déplacez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il GPS si attiva brevemente per verificare se è in corso uno spostamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動しているかを確認するため、GPSが短時間オンになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De GPS wordt kort ingeschakeld om te bevestigen of er beweging is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS jest włączany na krótko, aby potwierdzić, czy się poruszasz."
          }
        }
      }
    },
    "phase.stationary.explanation" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS je vypnuté nebo v hrubém režimu. Čeká se na pohyb, významnou změnu polohy nebo návštěvu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das GPS ist aus oder läuft nur grob. Wartet auf Bewegung, eine signifikante Standortänderung oder einen Besuch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS is off or coarse. Waiting for motion, a significant location change or a visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El GPS está desactivado o en modo impreciso. A la espera de movimiento, un cambio significativo de ubicación o una visita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le GPS est éteint ou en mode approximatif. En attente d’un mouvement, d’un changement de position significatif ou d’une visite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il GPS è spento o in modalità approssimativa. In attesa di un movimento, di un cambiamento significativo di posizione o di una visita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPSはオフまたは粗い状態です。動き、大幅な位置の変更、訪問のいずれかを待機しています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De GPS is uitgeschakeld of grof. Wachten op beweging, een significante locatiewijziging of een bezoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS jest wyłączony lub działa w trybie przybliżonym. Oczekiwanie na ruch, znaczącą zmianę lokalizacji lub wizytę."
          }
        }
      }
    },
