    "status.state.stale" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už chvíli nepřišel žádný nový fix. Pokud byla aplikace vynuceně ukončena, otevřete ji znovu pro obnovení sledování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit einiger Zeit kein neuer Fix. Falls Sie die App manuell beendet haben, öffnen Sie sie erneut, um die Aufzeichnung fortzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No new fix for a while. If the app was force-quit, reopen it to resume tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin nuevas posiciones GPS desde hace un tiempo. Si la app se cerró a la fuerza, vuelva a abrirla para reanudar el seguimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun nouveau point depuis un moment. Si l’app a été fermée de force, rouvrez-la pour reprendre l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun nuovo fix da un po'. Se l'app è stata chiusa forzatamente, riaprila per riprendere il monitoraggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらく新しい測位がありません。Appが強制終了された場合は、もう一度開くと記録を再開します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al een tijdje geen nieuwe fix. Als de app geforceerd is afgesloten, open deze dan opnieuw om het bijhouden te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak nowego fixu od dłuższego czasu. Jeśli aplikacja została zamknięta ręcznie, otwórz ją ponownie, aby wznowić śledzenie."
          }
        }
      }
    },
