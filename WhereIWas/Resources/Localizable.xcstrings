    "settings.filter.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixy, které jsou méně přesné než limit, starší než maximální stáří nebo blíž k předchozímu fixu než vzdálenost duplicit, se vyřazují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes, die ungenauer als das Limit sind, das maximale Alter überschreiten oder innerhalb des Duplikatabstands zum vorherigen Fix liegen, werden verworfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes less accurate than the limit, older than the max age, or within the duplicate distance of the previous fix are discarded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descartan las posiciones GPS menos precisas que el límite, las que superan la antigüedad máxima o las situadas a menos de la distancia de duplicado respecto a la posición anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points moins précis que la limite, plus anciens que l’âge maximal, ou situés à moins de la distance de doublon du point précédent sont écartés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fix meno precisi del limite, più vecchi dell'età massima o entro la distanza duplicati dal fix precedente vengono scartati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限より精度が低い測位、最大経過時間を超えた測位、直前の測位との距離が重複距離以内の測位は破棄されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes die minder nauwkeurig zijn dan de limiet, ouder zijn dan de maximale leeftijd of binnen de duplicaatafstand van de vorige fix liggen, worden geweigerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixy mniej dokładne niż limit, starsze niż maksymalny wiek lub leżące bliżej poprzedniego fixu niż odległość duplikatu są odrzucane."
          }
        }
      }
    },
