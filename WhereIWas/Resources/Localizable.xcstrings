    "warning.whenInUse.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledování na pozadí se zastaví, jakmile je aplikace pozastavena. V Nastavení změňte přístup k poloze na „Vždy“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung im Hintergrund stoppt, sobald iOS die App anhält. Ändern Sie den Standortzugriff in den Einstellungen auf „Immer“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background tracking stops as soon as the app is suspended. Change location access to “Always” in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento en segundo plano se detiene en cuanto la app se suspende. Cambie el acceso a la ubicación a «Siempre» en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi en arrière-plan s’arrête dès que l’app est suspendue. Passez l’accès à la position sur « Toujours » dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il monitoraggio in background si interrompe non appena l'app viene sospesa. Imposta l'accesso alla posizione su «Sempre» nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appが一時停止されると、バックグラウンドでの追跡は停止します。設定で位置情報へのアクセスを「常に」に変更してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bijhouden op de achtergrond stopt zodra de app wordt onderbroken. Wijzig locatietoegang naar „Altijd” in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledzenie w tle zatrzymuje się, gdy tylko aplikacja zostanie zawieszona. Zmień dostęp do lokalizacji na „Zawsze” w Ustawieniach."
          }
        }
      }
    },
