    "warning.motionDenied.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pohybové aktivity se aplikace musí při detekci pohybu spoléhat na GPS, což spotřebovává více baterie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Bewegungsaktivität muss sich die App zur Bewegungserkennung auf das GPS verlassen, was mehr Akku verbraucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without motion activity the app must rely on GPS to detect movement, which uses more battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin la actividad de movimiento, la app debe depender del GPS para detectar el movimiento, lo que consume más batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans les données de mouvement, l’app doit s’appuyer sur le GPS pour détecter les déplacements, ce qui consomme plus de batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza l'attività di movimento, l'app deve affidarsi al GPS per rilevare gli spostamenti, il che consuma più batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーションアクティビティがないと、Appは移動の検出をGPSに頼らざるを得ず、バッテリー消費が増えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder bewegingsactiviteit moet de app op GPS vertrouwen om beweging te detecteren, wat meer batterij verbruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez danych o aktywności ruchowej aplikacja musi polegać na GPS do wykrywania ruchu, co zużywa więcej baterii."
          }
        }
      }
    },
