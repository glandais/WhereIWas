    "settings.retention.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staré vzorky se automaticky mažou úlohou údržby na pozadí, nebo zde na vyžádání. Relace se zachovávají."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte Messpunkte werden automatisch durch eine Wartungsaufgabe im Hintergrund gelöscht, oder hier auf Wunsch. Sitzungen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Old samples are deleted automatically by a background maintenance task, or here on demand. Sessions are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las muestras antiguas se eliminan automáticamente mediante una tarea de mantenimiento en segundo plano, o aquí bajo demanda. Las sesiones se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciens échantillons sont supprimés automatiquement par une tâche de maintenance en arrière-plan, ou ici à la demande. Les sessions sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I campioni vecchi vengono eliminati automaticamente da un'attività di manutenzione in background, oppure qui su richiesta. Le sessioni vengono conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いサンプルはバックグラウンドのメンテナンスタスクによって自動的に削除されるほか、ここから随時削除できます。セッションは保持されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oude meetpunten worden automatisch verwijderd door een onderhoudstaak op de achtergrond, of hier op aanvraag. Sessies worden bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stare próbki są usuwane automatycznie przez zadanie konserwacji w tle albo tutaj na żądanie. Sesje są zachowywane."
          }
        }
      }
    },
