            "state": "translated",
            "value": "Du"
          }
        }
      }
    },
    "GPS is off or coarse. Waiting for motion, a significant location change or a visit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS est éteint ou en mode grossier. En attente d’un mouvement, d’un changement de position significatif ou d’une visite."
          }
        }
      }
    },
    "GPS is on briefly to confirm whether you are moving.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS est activé brièvement pour confirmer si vous vous déplacez."
          }
        }
      }
    },
    "GPS is on, tuned to your current speed and activity.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS est activé, réglé sur votre vitesse et votre activité actuelles."
