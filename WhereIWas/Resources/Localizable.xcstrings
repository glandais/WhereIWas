    "warning.preciseOff.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzorky jsou přesné jen na několik kilometrů. V Nastavení zapněte Přesnou polohu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messpunkte sind nur auf wenige Kilometer genau. Aktivieren Sie „Genauer Standort“ in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samples are only accurate to a few kilometers. Enable Precise Location in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las muestras solo tienen una precisión de unos pocos kilómetros. Active Ubicación precisa en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points ne sont précis qu’à quelques kilomètres. Activez la position précise dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I campioni sono precisi solo entro pochi chilometri. Attiva Posizione esatta nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプルの精度は数kmまで低下します。設定で正確な位置情報をオンにしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meetpunten zijn slechts tot op enkele kilometers nauwkeurig. Schakel Precieze locatie in bij Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbki są dokładne jedynie do kilku kilometrów. Włącz Dokładną lokalizację w Ustawieniach."
          }
        }
      }
    },
