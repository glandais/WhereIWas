    "phase.moving.explanation" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS je zapnuté a přizpůsobuje se aktuální rychlosti a aktivitě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das GPS ist aktiv und auf Ihre aktuelle Geschwindigkeit und Aktivität abgestimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS is on, tuned to your current speed and activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El GPS está activado y ajustado a la velocidad y la actividad actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le GPS est activé, réglé sur votre vitesse et votre activité actuelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il GPS è attivo, regolato in base alla velocità e all'attività correnti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPSはオンで、現在の速度とアクティビティに合わせて調整されています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De GPS is ingeschakeld, afgestemd op de huidige snelheid en activiteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS jest włączony i dostosowany do bieżącej prędkości i aktywności."
          }
        }
      }
    },
