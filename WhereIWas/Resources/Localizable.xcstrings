    "warning.locationDenied.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas nemůže nic zaznamenávat. V Nastavení povolte přístup k poloze „Vždy“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas kann nichts aufzeichnen. Erlauben Sie den Standortzugriff „Immer“ in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas cannot record anything. Allow location access “Always” in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas no puede registrar nada. Permita el acceso a la ubicación «Siempre» en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas ne peut rien enregistrer. Autorisez l’accès à la position « Toujours » dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas non può registrare nulla. Consenti l'accesso alla posizione «Sempre» nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWasは何も記録できません。設定で位置情報へのアクセスを「常に」に変更してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas kan niets registreren. Sta locatietoegang „Altijd” toe in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhereIWas nie może niczego zapisywać. Zezwól na dostęp do lokalizacji „Zawsze” w Ustawieniach."
          }
        }
      }
    },
