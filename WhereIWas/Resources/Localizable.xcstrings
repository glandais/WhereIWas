    },
    "GPX 1.1 track with elevation, time and extensions (speed, course, accuracy, activity, battery). Opens in most mapping tools.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace GPX 1.1 avec altitude, horodatage et extensions (vitesse, cap, précision, activité, batterie). S’ouvre dans la plupart des outils cartographiques."
          }
        }
      }
    },
    "Grant permissions": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accorder les autorisations"
          }
        }
      }
    },
    "Grant “Always” location access so tracking survives in the background.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’accès à la position « Toujours » pour que l’enregistrement se poursuive en arrière-plan."
