    "warning.motionNotDetermined.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohybová aktivita umožňuje aplikaci vypnout GPS, když jste v klidu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bewegungsaktivität ermöglicht es der App, das GPS auszuschalten, wenn Sie sich nicht bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion activity lets the app switch GPS off while you are still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad de movimiento permite que la app apague el GPS en caso de inmovilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de mouvement permettent à l’app d’éteindre le GPS lorsque vous êtes immobile."
          }
        },
        "it" : {
          "stringUnit" : {
