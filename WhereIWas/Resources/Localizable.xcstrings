        }
      }
    },
    "Fixes less accurate than the limit, older than the max age, or within the duplicate distance of the previous fix are discarded.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points moins précis que la limite, plus anciens que l’âge maximal, ou situés à moins de la distance de doublon du point précédent sont écartés."
          }
        }
      }
    },
    "Forever": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans limite"
          }
        }
