    "warning.locationNotDetermined.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělte přístup k poloze „Vždy“, aby sledování pokračovalo na pozadí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erteilen Sie den Standortzugriff „Immer“, damit die Aufzeichnung im Hintergrund erhalten bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant “Always” location access so tracking survives in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda el acceso a la ubicación «Siempre» para que el seguimiento continúe en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accordez l’accès à la position « Toujours » pour que l’enregistrement se poursuive en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi l'accesso alla posizione «Sempre» affinché il monitoraggio continui in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドでも記録が続くように、位置情報へのアクセスを「常に」に許可してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleen locatietoegang „Altijd” zodat het bijhouden op de achtergrond blijft werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyznaj dostęp do lokalizacji „Zawsze”, aby śledzenie działało również w tle."
          }
        }
      }
    },
