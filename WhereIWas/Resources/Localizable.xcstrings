    "settings.units.footer" : {
      "comment" : "Footer under the unit system picker",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změní způsob zobrazení vzdáleností, rychlostí, výšek a přesností. Uložené vzorky a exporty tím nejsou dotčeny: vždy ukládají metry a metry za sekundu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Anzeige von Distanzen, Geschwindigkeiten, Höhen und Genauigkeiten. Aufgezeichnete Messpunkte und Exporte sind davon nicht betroffen: Sie speichern immer Meter und Meter pro Sekunde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes how distances, speeds, altitudes and accuracies are displayed. Recorded samples and exports are unaffected: they always store meters and meters per second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia cómo se muestran las distancias, velocidades, altitudes y precisiones. Las muestras registradas y las exportaciones no se ven afectadas: siempre se almacenan en metros y metros por segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change l’affichage des distances, vitesses, altitudes et précisions. Les points enregistrés et les exports ne sont pas affectés : ils sont toujours en mètres et en mètres par seconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia il modo in cui vengono visualizzati distanze, velocità, altitudini e precisioni. I campioni registrati e gli export non sono interessati: memorizzano sempre metri e metri al secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離、速度、高度、精度の表示方法を変更します。記録済みのサンプルとエクスポートには影響しません。常にメートルおよびメートル毎秒で保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verandert hoe afstanden, snelheden, hoogtes en nauwkeurigheden worden weergegeven. Opgeslagen meetpunten en exports blijven ongewijzigd: deze worden altijd opgeslagen in meter en meter per seconde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia sposób wyświetlania odległości, prędkości, wysokości i dokładności. Zapisane próbki i eksporty pozostają bez zmian: zawsze przechowują metry i metry na sekundę."
          }
        }
      }
    },
