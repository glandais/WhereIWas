    "export.format.gpxDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasa GPX 1.1 s nadmořskou výškou, časem a rozšířeními (rychlost, kurz, přesnost, aktivita, baterie). Otevře se ve většině mapových nástrojů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX-1.1-Track mit Höhe, Zeitstempel und Erweiterungen (Geschwindigkeit, Kurs, Genauigkeit, Aktivität, Akku). Lässt sich in den meisten Kartenprogrammen öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX 1.1 track with elevation, time and extensions (speed, course, accuracy, activity, battery). Opens in most mapping tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traza GPX 1.1 con altitud, hora y extensiones (velocidad, rumbo, precisión, actividad, batería). Se abre en la mayoría de las herramientas cartográficas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trace GPX 1.1 avec altitude, horodatage et extensions (vitesse, cap, précision, activité, batterie). S’ouvre dans la plupart des outils cartographiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia GPX 1.1 con altitudine, orario ed estensioni (velocità, direzione, precisione, attività, batteria). Si apre nella maggior parte degli strumenti cartografici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標高、時刻、拡張情報（速度、進行方向、精度、アクティビティ、バッテリー）を含むGPX 1.1の軌跡。ほとんどの地図ツールで開けます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX 1.1-track met hoogte, tijd en extensies (snelheid, koers, nauwkeurigheid, activiteit, batterij). Te openen in de meeste kaartprogramma's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ślad GPX 1.1 z wysokością, znacznikiem czasu i rozszerzeniami (prędkość, kurs, dokładność, aktywność, bateria). Otwiera się w większości aplikacji mapowych."
          }
        }
      }
    },
