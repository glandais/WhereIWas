          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーションアクティビティにより、静止中はGPSをオフに切り替えられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
