    "settings.motion.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delší nehybnost brání kolísání stavu na semaforech, ale po zastavení nechává GPS zapnuté déle. Hrubé aktualizace (přesnost 3 km) mají téměř nulovou spotřebu a udržují aplikaci aktivní na pozadí — proto systémový indikátor polohy svítí, i když jste v klidu. Vypnutí této volby indikátor skryje, ale iOS ho stejně zobrazí, kdykoli GPS zaznamenává na pozadí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine längere Stillstandsdauer vermeidet Wechsel an Ampeln, hält das GPS aber nach dem Anhalten länger eingeschaltet. Grobe Aktualisierungen (Genauigkeit 3 km) kosten fast nichts und halten die App im Hintergrund aktiv — deshalb bleibt die Standortanzeige des Systems im Stillstand eingeschaltet. Das Deaktivieren blendet sie aus, aber iOS zeigt sie trotzdem an, sobald das GPS im Hintergrund aufzeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longer stillness avoids flapping at traffic lights but keeps GPS on longer after you stop. Coarse updates (3 km accuracy) cost almost nothing and keep the app alive in the background — which is why the system location indicator stays on while stationary. Turning off “Show location indicator” hides it, but iOS still shows it whenever GPS is recording in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una inmovilidad más larga evita las oscilaciones en los semáforos, pero mantiene el GPS encendido más tiempo tras detenerse. Las actualizaciones de baja precisión (3 km) apenas consumen recursos y mantienen la app activa en segundo plano; por eso el indicador de ubicación del sistema permanece encendido en estado estacionario. Desactivar esta opción lo oculta, pero iOS lo sigue mostrando siempre que el GPS esté registrando en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une immobilité plus longue évite les basculements aux feux rouges, mais garde le GPS allumé plus longtemps après l’arrêt. Les mises à jour approximatives (précision 3 km) ne coûtent presque rien et maintiennent l’app active en arrière-plan — c’est pourquoi l’indicateur de localisation du système reste allumé à l’arrêt. Le désactiver le masque, mais iOS l’affiche quand même dès que le GPS enregistre en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'immobilità più lunga evita i cambi di stato ai semafori, ma tiene il GPS acceso più a lungo dopo l'arresto. Gli aggiornamenti approssimativi (precisione 3 km) costano quasi nulla e mantengono l'app attiva in background — per questo l'indicatore di posizione del sistema resta acceso da stazionario. Disattivarlo lo nasconde, ma iOS lo mostra comunque ogni volta che il GPS registra in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静止判定までの時間を長くすると信号待ちでの切り替わりを防げますが、停止後もGPSがオンのままになる時間が長くなります。粗い位置情報の更新（精度3km）はほとんど負荷がなく、バックグラウンドでAppを維持します。静止中もシステムの位置情報インジケータが表示され続けるのはこのためです。オフにすると非表示になりますが、GPSがバックグラウンドで記録している間はiOSが表示を続けます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een langere stilstand voorkomt schakelen bij verkeerslichten, maar houdt de GPS langer aan na het stoppen. Grove updates (nauwkeurigheid 3 km) kosten vrijwel niets en houden de app actief op de achtergrond — daarom blijft de locatie-indicator van het systeem aan bij stilstand. Uitschakelen verbergt deze, maar iOS toont hem nog steeds zodra de GPS op de achtergrond registreert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dłuższy czas bezruchu ogranicza przełączanie stanów na światłach, ale utrzymuje GPS włączony dłużej po zatrzymaniu. Przybliżone aktualizacje (dokładność 3 km) kosztują niemal nic i utrzymują aplikację aktywną w tle — dlatego systemowy wskaźnik lokalizacji pozostaje włączony w bezruchu. Wyłączenie tej opcji ukrywa go, ale iOS i tak go pokazuje, gdy GPS rejestruje dane w tle."
          }
        }
      }
    },
