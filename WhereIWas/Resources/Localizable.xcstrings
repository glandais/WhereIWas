    "audit.disabled.description" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte jej v Nastavení a budou se zaznamenávat všechny přijaté fixy, všechny na nich provedené ověřovací testy a každá změna stavu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie es in den Einstellungen ein, um jeden empfangenen Fix, jeden daran durchgeführten Validierungstest und jeden Statuswechsel aufzuzeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it on in Settings to record every fix received, every validation test run on it, and every state change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívelo en Ajustes para registrar cada posición recibida, cada prueba de validación ejecutada y cada cambio de estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-le dans les réglages pour enregistrer chaque point reçu, chaque test de validation effectué et chaque changement d’état."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivalo in Impostazioni per registrare ogni fix ricevuto, ogni test di validazione eseguito e ogni cambio di stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でオンにすると、受信した各測位、それに対して実行した各検証テスト、状態の変化がすべて記録されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel het in bij Instellingen om elke ontvangen fix, elke validatietest die daarop is uitgevoerd en elke statuswijziging vast te leggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz go w Ustawieniach, aby rejestrować każdy odebrany fix, każdy wykonany na nim test walidacji i każdą zmianę stanu."
          }
