    "status.transitions.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přechod z pohybu do klidu vyžaduje %@ nehybnosti; jakýkoli pohyb okamžitě znovu zapne GPS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Übergang „In Bewegung“ → „Stationär“ erfordert %@ Stillstand; jede Bewegung schaltet das GPS sofort wieder ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moving → stationary requires %@ of stillness; any motion switches GPS back on immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paso de «en movimiento» a «estacionario» exige %@ de inmovilidad; cualquier movimiento vuelve a activar el GPS de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le passage « en mouvement → à l’arrêt » exige %@ d’immobilité ; tout mouvement rallume le GPS immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il passaggio da in movimento a stazionario richiede %@ di immobilità; qualsiasi movimento riaccende subito il GPS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動中→静止には%@の静止が必要です。動きがあれば直ちにGPSが再びオンになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overgang „in beweging” → „stilstaand” vereist %@ stilstand; elke beweging schakelt de GPS onmiddellijk weer in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejście „W ruchu” → „Bezruch” wymaga %@ bez wykrytego ruchu; każdy ruch natychmiast włącza GPS z powrotem."
          }
        }
      }
    },
