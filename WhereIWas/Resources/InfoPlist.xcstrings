{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas zaznamenává vaši polohu na pozadí, i když je obrazovka zamčená, aby se neztratila žádná část trasy — ani během několika dní — a data zůstávají v tomto zařízení, dokud je sami neexportujete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas zeichnet Ihren Standort im Hintergrund auf, auch bei gesperrtem Bildschirm, damit kein Teil Ihrer Wege verloren geht — auch über mehrere Tage hinweg — und alles bleibt auf diesem Gerät, bis Sie es exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas records your position in the background, including while the screen is locked, so that no part of your route is lost — even over several days — and it stays on this device until you export it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas registra la posición en segundo plano, incluso con la pantalla bloqueada, para que no se pierda ninguna parte de sus desplazamientos, ni siquiera a lo largo de varios días; los datos permanecen en este dispositivo hasta que se exporten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas enregistre votre position en arrière-plan, y compris lorsque l’écran est verrouillé, afin qu’aucune partie de votre trajet ne soit perdue — même sur plusieurs jours — et tout reste sur cet appareil jusqu’à ce que vous l’exportiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas registra la tua posizione in background, anche a schermo bloccato, così nessun tratto del tuo percorso va perduto — nemmeno nell’arco di più giorni — e i dati restano su questo dispositivo finché non li esporti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWasは、画面がロックされている間もバックグラウンドで位置情報を記録し、数日間に及ぶ移動でも経路が欠けないようにします。データはエクスポートするまでこのデバイス内に保存されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas legt de positie vast op de achtergrond, ook als het scherm vergrendeld is, zodat er geen deel van de route verloren gaat — ook niet over meerdere dagen — en alles op dit apparaat blijft totdat u het exporteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas zapisuje pozycję w tle, także przy zablokowanym ekranie, aby żaden fragment trasy nie został utracony — nawet przez kilka dni — a dane pozostają na tym urządzeniu do czasu ich wyeksportowania."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas zaznamenává polohu, když je aplikace otevřená, abyste viděli trasu na mapě a mohli ji exportovat jako GPX nebo JSON."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas zeichnet Ihren Standort auf, während die App geöffnet ist, damit Sie Ihre Strecke auf der Karte sehen und als GPX oder JSON exportieren können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas records your position while the app is open, so you can see your track on the map and export it as GPX or JSON."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas registra la posición mientras la app está abierta, para mostrar el recorrido en el mapa y exportarlo en GPX o JSON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas enregistre votre position lorsque l’app est ouverte, pour afficher votre trajet sur la carte et l’exporter en GPX ou JSON."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas registra la tua posizione mentre l’app è aperta, per mostrarti il percorso sulla mappa ed esportarlo in GPX o JSON."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWasは、Appを開いている間に位置情報を記録し、経路を地図に表示したりGPXまたはJSONで書き出したりできるようにします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas legt de positie vast terwijl de app geopend is, zodat u de route op de kaart ziet en als GPX of JSON kunt exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas zapisuje pozycję, gdy aplikacja jest otwarta, aby pokazać trasę na mapie i umożliwić jej eksport do GPX lub JSON."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohybová aktivita (chůze, jízda, nehybnost) slouží k zapnutí GPS pouze při pohybu, což šetří baterii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bewegungsaktivität (Gehen, Fahren, Stillstand) dient dazu, GPS nur bei tatsächlicher Bewegung einzuschalten, was den Akku schont."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion activity (walking, driving, still) is used to switch GPS on only when you are moving, which saves battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad de movimiento (caminata, conducción, inmovilidad) sirve para activar el GPS solo cuando hay desplazamiento, lo que ahorra batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de mouvement (marche, conduite, immobilité) servent à n’activer le GPS que lorsque vous vous déplacez, ce qui économise la batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attività di movimento (camminata, guida, immobilità) serve ad attivare il GPS solo quando ti muovi, riducendo il consumo della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーションアクティビティ（歩行、運転、静止）は、実際に移動しているときだけGPSを有効にし、バッテリーの消費を抑えるために使用します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegingsactiviteit (lopen, rijden, stilstand) wordt gebruikt om GPS alleen tijdens verplaatsing in te schakelen, wat de batterij spaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywność ruchowa (chód, jazda, bezruch) służy do włączania GPS tylko podczas przemieszczania się, co oszczędza baterię."
          }
        }
      }
    }
  },
  "version": "1.0"
}
