{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas enregistre votre position en continu, y compris en arrière-plan, afin que vos déplacements pendant une intervention ne soient jamais perdus. Les données restent sur cet appareil jusqu’à ce que vous les exportiez."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhereIWas enregistre votre position pour constituer votre historique de déplacements."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activité physique (marche, conduite, immobilité) sert à n’activer le GPS que lorsque vous vous déplacez, ce qui économise la batterie."
          }
        }
      }
    }
  },
  "version": "1.0"
}
